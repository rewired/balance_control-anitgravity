{
  "name": "balance-control-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint \"packages/**/*.{ts,tsx,js,cjs,mjs}\" \"scripts/**/*.{js,cjs,mjs}\" \"*.{js,cjs,mjs}\"",
    "check:encoding": "node scripts/check-encoding.mjs",
    "gen:spec-anchors": "node scripts/gen-spec-anchors.mjs",
    "audit:spec": "pnpm run gen:spec-anchors && pnpm -C packages/game test -- spec-anchor-tripwire.test.ts && pnpm -C packages/game test -- computeMajorirty.test.ts moves.test.ts hotspot.test.ts && pnpm -C packages/game test -- golden-replay.test.ts",
    "dev": "pnpm -r --parallel dev",
    "verify:task": "node scripts/verify-task.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.18.0",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^0.30.0"
  },
  "engines": {
    "node": ">=18"
  }
}
