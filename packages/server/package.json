{
  "name": "@balance-control/server",
  "version": "0.0.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "pnpm run dev:deps && concurrently \"pnpm run dev:watch\" \"pnpm node scripts/wait-for-dist-watch.cjs\"",
    "test": "vitest run",
    "dev:deps": "pnpm -C ../game build && pnpm -C ../packs build",
    "dev:watch": "tsc -w"
  },
  "dependencies": {
    "boardgame.io": "^0.50.0",
    "@balance-control/game": "workspace:*",
    "@balance-control/packs": "workspace:*",
    "@balance-control/expansion-01": "workspace:*",
    "@balance-control/expansion-02": "workspace:*",
    "@balance-control/expansion-03": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "vitest": "^0.34.6"
  }
}
