{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["vite/client"],
        "jsx": "react-jsx",
        "paths": {
            "@balance-control/game": ["../game/src"],
            "@balance-control/rules": ["../rules/src"],
            "@balance-control/shared": ["../shared/src"],
            "@balance-control/expansion-01": ["../expansion-01/src"],
            "@balance-control/expansion-02": ["../expansion-02/src"],
            "@balance-control/expansion-03": ["../expansion-03/src"],
            "@balance-control/expansion-01/engine": ["../expansion-01/src/engine"],
            "@balance-control/expansion-02/engine": ["../expansion-02/src/engine"],
            "@balance-control/expansion-03/engine": ["../expansion-03/src/engine"],
            "@balance-control/bot-llm": ["../bot-llm/src"]
        }
    },
    "include": [
        "src",
        "../bot-llm/src",
        "../game/src",
        "../rules/src",
        "../shared/src",
        "../expansion-01/src",
        "../expansion-02/src",
        "../expansion-03/src"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
