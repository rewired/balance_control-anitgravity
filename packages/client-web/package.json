{
  "name": "@balance-control/client-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm -C ../rules build && pnpm -C ../game build && pnpm -C ../expansion-01 build && pnpm -C ../expansion-02 build && pnpm -C ../expansion-03 build && pnpm -C ../packs build",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@balance-control/expansion-01": "workspace:*",
    "@balance-control/expansion-02": "workspace:*",
    "@balance-control/expansion-03": "workspace:*",
    "@balance-control/game": "workspace:*",
    "@balance-control/packs": "workspace:*",
    "@balance-control/rules": "workspace:*",
    "boardgame.io": "^0.50.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.6",
    "jsdom": "^28.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^0.34.6"
  }
}
